{
  "name": "map-editor",
  "private": true,
  "version": "0.1.0",
  "description": "WarOfState-Remake 外置数据工具（T-164）：units/buildings/rules 配置表单，Godot gate 落盘门禁",
  "main": "src/main/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "electron .",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --experimental-strip-types --test \"tests/unit/*.test.mjs\"",
    "gate": "npm run typecheck && npm run test:unit && npm run build && npm run smoke",
    "smoke": "node scripts/smoke.mjs",
    "pack": "node scripts/pack.mjs",
    "pack:zip": "node scripts/pack.mjs --zip"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "chrome-remote-interface": "^0.33.0",
    "electron": "^44.0.0",
    "typescript": "^5.5.0",
    "vite": "^7.0.0"
  }
}
